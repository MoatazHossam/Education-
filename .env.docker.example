# Environment for docker compose. Copy to .env.docker (development) or
# .env.production and replace every secret. Never commit the copies.
APP_URL=http://localhost:3000
APP_PORT=3000
NODE_ENV=development

# Database passwords: letters and digits only (they go inside database addresses), e.g. openssl rand -hex 24
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
DB_NAME=midad
DB_OWNER_USER=midad_owner
DB_OWNER_PASSWORD=change-me-owner
DB_APP_USER=midad_app
DB_APP_PASSWORD=change-me-app
DB_BACKUP_USER=midad_backup
DB_BACKUP_PASSWORD=change-me-backup

# openssl rand -base64 48
SESSION_SECRET=
# openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Only while rotating DATA_ENCRYPTION_KEY: the old key(s), comma-separated (docs/DEPLOYMENT_GUIDE.md)
DATA_ENCRYPTION_KEYS_PREVIOUS=

EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://mailpit:1025
EMAIL_FROM=Midad <no-reply@localhost>
SALES_EMAIL=

BILLING_PROVIDER=sandbox
SANDBOX_WEBHOOK_SECRET=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=

# Operational alerts (worker stopped, emails failing, server errors, database down...):
# comma-separated addresses and/or a webhook URL (Slack, Discord, Mattermost or any JSON
# endpoint). Sent directly by the app, not through the email queue. Counts only, no customer data.
ALERT_EMAILS=
ALERT_WEBHOOK_URL=

# Homework files are scanned for viruses by ClamAV before anyone can open them
# (docs/CLASSROOM.md §5). docker-compose.prod.yml runs ClamAV and sets clamav;
# set off to turn scanning off (photos are still resized).
FILE_SCAN=

# AI assistance (docs/AI_LAYER.md): none (default), gemini, anthropic or openai. With a provider,
# AI_API_KEY and AI_MODEL are required. Schools use it only once a platform administrator gives
# them a monthly allowance. Use a paid API tier whose terms exclude training on your requests.
# Check the setup with: npm run ai:check
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# Production only (docker-compose.prod.yml)
DOMAIN=
ACME_EMAIL=

# --- Optional. Empty means the default shown. ---
# A managed PostgreSQL instead of the bundled postgres service: full addresses for the app role
# and the schema owner, and DATABASE_SSL=true. The ops scripts then start without the bundled one.
DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_SSL=
# For backups of a managed database (the read-only backup role, ops/backup.sh): postgres://midad_backup:…@host:5432/db
BACKUP_DATABASE_URL=
# Connections per app instance (10)
DATABASE_POOL_MAX=
# Trial, grace after a failed renewal, renewal notice (14, 7, 7 days); audit log kept (730 days)
TRIAL_DAYS=
GRACE_DAYS=
RENEWAL_NOTICE_DAYS=
AUDIT_RETENTION_DAYS=
# info, or debug / warn / error
LOG_LEVEL=
# Worker pass (15000 ms), alert checks (60000 ms), drain before an instance stops (production 5000 ms)
WORKER_INTERVAL_MS=
ALERT_CHECK_INTERVAL_MS=
SHUTDOWN_DRAIN_MS=
# ClamAV port (3310); Paymob API (https://accept.paymob.com)
CLAMAV_PORT=
PAYMOB_API_BASE=
# AI: a different endpoint, the request timeout (120000 ms), most output tokens per request (16000)
AI_API_BASE=
AI_TIMEOUT_MS=
AI_MAX_OUTPUT_TOKENS=
# Which app image to run: local (built here), or previous (the one before the last rebuild by
# scripts/rolling-restart.sh --build or the start script), for a rollback; remove before the next upgrade
APP_IMAGE_TAG=
