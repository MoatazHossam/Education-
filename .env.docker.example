# Environment for docker compose. Copy to .env.docker (development) or
# .env.production and replace every secret. Never commit the copies.
APP_URL=http://localhost:3000
APP_PORT=3000
NODE_ENV=development

POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
DB_NAME=curriculum_scope
DB_OWNER_USER=curriculum_owner
DB_OWNER_PASSWORD=change-me-owner
DB_APP_USER=curriculum_app
DB_APP_PASSWORD=change-me-app
DB_BACKUP_USER=curriculum_backup
DB_BACKUP_PASSWORD=change-me-backup

# openssl rand -base64 48
SESSION_SECRET=
# openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Only while rotating DATA_ENCRYPTION_KEY: the old key(s), comma-separated (docs/DEPLOYMENT_GUIDE.md)
DATA_ENCRYPTION_KEYS_PREVIOUS=

EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://mailpit:1025
EMAIL_FROM=Curriculum Scope <no-reply@localhost>
SALES_EMAIL=

BILLING_PROVIDER=sandbox
SANDBOX_WEBHOOK_SECRET=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=

# Operational alerts (worker stopped, emails failing, server errors, database down...):
# comma-separated addresses and/or a webhook URL (Slack, Discord, Mattermost or any JSON
# endpoint). Sent directly by the app, not through the email queue. Counts only, no customer data.
ALERT_EMAILS=
ALERT_WEBHOOK_URL=

# Homework files are scanned for viruses by ClamAV before anyone can open them
# (docs/CLASSROOM.md §5). docker-compose.prod.yml runs ClamAV and sets clamav;
# set off to turn scanning off (photos are still resized).
FILE_SCAN=

# Production only (docker-compose.prod.yml)
DOMAIN=
ACME_EMAIL=
