# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Public base URL (used in emails, CSRF origin checks, cookie security). https:// in production.
APP_URL=http://localhost:3000
LOG_LEVEL=info
# Set true when running behind a reverse proxy (Caddy/Nginx) so client IPs are correct.
TRUST_PROXY=false

# Runtime connection: least-privilege role (no superuser, no BYPASSRLS) so Row-Level Security applies.
DATABASE_URL=postgres://curriculum_app:change-me-app@localhost:5432/curriculum_scope
# Schema owner, used only by migrations and seeding.
MIGRATION_DATABASE_URL=postgres://curriculum_owner:change-me-owner@localhost:5432/curriculum_scope
# Role that migrations grant runtime privileges to.
APP_DB_ROLE=curriculum_app
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters
# Generate with: openssl rand -base64 32   (32 bytes, base64) — encrypts TOTP secrets at rest
DATA_ENCRYPTION_KEY=

# smtp | log (development: prints emails) | none
EMAIL_TRANSPORT=log
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Curriculum Scope <no-reply@example.com>"
# Shown as the "Contact sales" address for non-self-serve plans (optional)
SALES_EMAIL=

# sandbox (development/test only) | paymob | disabled (manual invoicing only)
BILLING_PROVIDER=sandbox
BILLING_CURRENCY=EGP
SANDBOX_WEBHOOK_SECRET=replace-with-a-random-sandbox-secret
PAYMOB_API_BASE=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Comma-separated Paymob integration ids (card, wallet...)
PAYMOB_INTEGRATION_IDS=

TRIAL_DAYS=14
GRACE_DAYS=7
RENEWAL_NOTICE_DAYS=7
AUDIT_RETENTION_DAYS=730
RATE_LIMIT_ENABLED=true
WORKER_INTERVAL_MS=15000

# Development seed only
DEMO_PASSWORD=
