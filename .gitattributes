# Check out text files with LF line endings on every OS, including Windows with
# core.autocrlf=true. Shell scripts run inside Linux containers (the PostgreSQL
# init script, backups) fail with CRLF: "/bin/sh^M: bad interpreter".
* text=auto eol=lf

# Windows batch files need CRLF line endings.
*.bat text eol=crlf

# Word files are binary: never convert their line endings.
*.docx binary
VERSION export-subst

# Test recordings, fonts, models and rendered documents (meeting-minutes/) are binary.
*.wav binary
*.mp3 binary
*.m4a binary
*.ogg binary
*.flac binary
*.webm binary
*.pdf binary
*.png binary
*.ttf binary
*.onnx binary
