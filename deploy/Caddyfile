{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	# The app sets CSP/HSTS itself; Caddy adds TLS (automatic Let's Encrypt), compression
	# and load balancing across the two app instances (docker-compose.prod.yml).
	reverse_proxy app:3000 app2:3000 {
		lb_policy round_robin
		# An instance that cannot be reached (restarting, crashed) is skipped: the request
		# goes to the other one. Requests whose connection failed after being sent are
		# retried only when they are GETs (Caddy's default), so nothing is applied twice.
		lb_try_duration 10s
		lb_try_interval 250ms
		fail_duration 10s
		# Readiness, not just liveness: database reachable, schema current, not draining.
		health_uri /readyz
		health_interval 2s
		health_timeout 2s
	}
	log {
		output stdout
		format json
	}
}
