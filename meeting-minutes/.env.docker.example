# Mahdar (meeting minutes) — settings for docker-compose.yml. Copy to .env.docker and fill in.
# Never commit .env.docker.

# --- Required secrets ---------------------------------------------------------------------------
# Database owner password (migrations only):   openssl rand -hex 24
POSTGRES_PASSWORD=
# Password of mahdar_app, the role the API and the worker use (row-level security applies to it): openssl rand -hex 24
MAHDAR_APP_DB_PASSWORD=
# Signs login sessions:          openssl rand -base64 48
MAHDAR_SECRET_KEY=
# Encrypts recordings, transcripts and documents at rest (AES-256-GCM, 32 bytes): openssl rand -base64 32
# Keep a copy somewhere safe: without it, stored recordings and documents cannot be read.
MAHDAR_DATA_KEY=
# After rotating MAHDAR_DATA_KEY, the old keys (comma-separated) until `mahdar.cli rotate-data-key` has run.
MAHDAR_DATA_KEYS_PREVIOUS=

# --- General ------------------------------------------------------------------------------------
# development or production (production refuses weak or missing secrets and plain-HTTP public URLs).
MAHDAR_ENV=development
MAHDAR_PUBLIC_URL=http://localhost:8080
MAHDAR_PORT=8080
MAHDAR_BIND=127.0.0.1
MAHDAR_LOG_LEVEL=info
# Upload limits (defaults: 500 MB, 240 minutes).
MAHDAR_MAX_UPLOAD_MB=
MAHDAR_MAX_DURATION_MINUTES=

# --- Privacy: external processing ---------------------------------------------------------------
# Nothing is sent to an external AI provider unless it is listed here AND the organization allows it
# for that kind of data (audio, transcript) in its privacy settings. Empty = local processing only.
# Example: MAHDAR_ALLOWED_EXTERNAL_PROVIDERS=anthropic
MAHDAR_ALLOWED_EXTERNAL_PROVIDERS=

# --- Speech recognition -------------------------------------------------------------------------
# faster_whisper (local; the model is downloaded once into the models volume), openai, deepgram, azure.
MAHDAR_ASR_PROVIDER=faster_whisper
# large-v3 gives the best Arabic accuracy; it needs about 4 GB of RAM with int8 on CPU.
MAHDAR_WHISPER_MODEL=large-v3
MAHDAR_WHISPER_DEVICE=cpu
MAHDAR_WHISPER_COMPUTE_TYPE=int8
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Speaker diarization ------------------------------------------------------------------------
# sherpa_onnx (local, no account needed), pyannote (image built with WITH_PYANNOTE=true; needs HF_TOKEN
# and the model's terms accepted on Hugging Face), asr (the speech provider's labels) or none.
MAHDAR_DIARIZATION_PROVIDER=sherpa_onnx
HF_TOKEN=

# --- Reasoning and writing (minutes) --------------------------------------------------------------
# anthropic (Claude; add "anthropic" to MAHDAR_ALLOWED_EXTERNAL_PROVIDERS) or openai_compatible
# (a server on your own network, such as vLLM or Ollama, with MAHDAR_LLM_BASE_URL).
MAHDAR_LLM_PROVIDER=anthropic
MAHDAR_LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
MAHDAR_LLM_BASE_URL=
MAHDAR_LLM_API_KEY=

# --- Storage --------------------------------------------------------------------------------------
# local (the storage volume) or s3 (any S3-compatible store; files are encrypted before upload).
MAHDAR_STORAGE_BACKEND=local
MAHDAR_S3_BUCKET=
MAHDAR_S3_ENDPOINT=
MAHDAR_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- TLS (docker compose --profile tls) ------------------------------------------------------------
MAHDAR_DOMAIN=
ACME_EMAIL=
