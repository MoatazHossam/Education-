{
  "name": "curriculum-scope",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS for planning Egyptian curriculum content scope (derived from the Egypt Curriculum Picker artifact).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "db:migrate": "tsx src/db/migrate-cli.ts up",
    "db:migrate:down": "tsx src/db/migrate-cli.ts down",
    "db:seed": "tsx src/db/seed-cli.ts",
    "db:migrate:prod": "node dist/db/migrate-cli.js up",
    "db:seed:prod": "node dist/db/seed-cli.js --catalog-only",
    "admin:create": "tsx src/cli/create-platform-admin.ts",
    "paymob:check": "tsx src/cli/paymob-check.ts",
    "keys:check": "tsx src/cli/rotate-data-key.ts --check",
    "keys:rotate": "tsx src/cli/rotate-data-key.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/e2e/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/readex-pro": "^5.2.6",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.6.0",
    "kysely": "^0.28.7",
    "nodemailer": "^10.2.0",
    "otplib": "^12.0.1",
    "pg": "^8.16.3",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.35.0",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^5.0.5"
  }
}
